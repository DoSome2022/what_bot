# ===== 管理員（可拉 bot 入群 + 執行管理指令），逗號分隔 =====
ADMIN_PHONES=85291234567,85298765432

# ===== 群組觸發（三選一或多選：@提及 / 符號前綴 / 暗號）=====
TRIGGER_SYMBOL=!
TRIGGER_PASSPHRASE=

# ===== 預設 AI =====
LLM_PROVIDER=deepseek
LLM_MODEL=

# ===== API Keys（用哪個就填哪個）=====
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ===== OpenAI 兼容端點（接中轉服務時，改 URL + 填 key）=====
# 例：OPENAI_BASE_URL=https://你的中轉網址/v1/chat/completions
OPENAI_BASE_URL=

# ===== Claude Code 模型後端（連接 claude/start.sh 的 DeepSeek / Kimi Anthropic 端點）=====
# 用法：LLM_PROVIDER=deepseek-anthropic 或 LLM_PROVIDER=kimi
DEEPSEEK_ANTHROPIC_TOKEN=
KIMI_ANTHROPIC_TOKEN=

# ===== 工具用 API（網上搜尋 / YouTube）=====
# 網上搜尋文章：到 https://tavily.com 註冊取得（!搜尋 用）
TAVILY_API_KEY=
# YouTube 搜尋：與 Gemini 同一個 Google API Key（!影片 用）
# GOOGLE_API_KEY= 已在上面，填同一把即可

# ===== 自動聯網（偵測到最新/今天/價格等關鍵字自動搜尋）=====
# true = 開啟（預設）；false = 關閉
AUTO_SEARCH=true

# ===== QR Code 顯示時間（毫秒，預設 600000 = 10 分鐘）=====
QR_TIMEOUT=600000

# ===== 系統提示詞（留空用預設拆骨公司客服）=====
SYSTEM_PROMPT=
